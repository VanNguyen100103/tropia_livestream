# Environment variables for Tropia Mobile App
# Base URL for API
# [LOCAL Go backend] — web (make dev-web / Chrome) talks to localhost:3000.
# Endpoint "login" => http://localhost:3000/api/login (LoginSpec, returns
# {Result:true, data:{token, user:{...}}} via EnvelopeWrapper).
# Physical phone on same Wi-Fi → use this PC's LAN IP (not localhost).
BASE_URL=http://192.168.4.2:3000/api/
# Web (make dev-web / Chrome on this PC):
# BASE_URL=http://localhost:3000/api/
# Android emulator → host:
# BASE_URL=http://10.0.2.2:3000/api/
# [OLD PHP server]
# BASE_URL=http://tropia.thienhaisoft.com/index.php?r=api/
# Image Base URL
IMAGE_URL=http://192.168.4.2:3000/
# [OLD] IMAGE_URL=http://tropia.thienhaisoft.com/

# API Key
API_KEY=your_secret_api_key_here
