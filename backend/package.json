{
  "name": "tropia-backend",
  "version": "2.0.0",
  "description": "Tropia Live Shopping – production backend (monolith)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development nodemon --env-file=.env.development src/index.js",
    "staging": "NODE_ENV=staging node --env-file=.env.staging src/index.js",
    "prod": "NODE_ENV=production node --env-file=.env.production src/index.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit tests/unit",
    "test:integration": "jest --runInBand --forceExit tests/integration",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.5",
    "amqplib": "^1.0.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  }
}
