# Tropia Backend – Environment Template
#
# Cách dùng:
#   cp .env.example .env.development   → local dev
#   cp .env.example .env.staging       → staging server
#   cp .env.example .env.production    → production server
#
# Chạy:
#   npm run dev        → load .env.development  (nodemon)
#   npm run staging    → load .env.staging
#   npm run prod       → load .env.production
#   (Docker)           → inject env vars trực tiếp, không dùng file

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# development → *
# staging     → https://staging.tropia.vn
# production  → https://tropia.vn
CORS_ORIGIN=*
CLIENT_URL=http://localhost:8080

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (không phải anon key!)

# ── LiveKit ───────────────────────────────────────────────────────────────────
# Self-hosted: wss://your-livekit-server.com
# LiveKit Cloud: wss://your-project.livekit.cloud
LIVEKIT_HOST=wss://your-livekit-server.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── JWT ───────────────────────────────────────────────────────────────────────
# generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
# local dev: localhost | docker/staging/prod: redis (service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# local dev: amqp://guest:guest@localhost:5672
# docker:    amqp://tropia:PASSWORD@rabbitmq:5672
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Tạo tại console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URIs phải khớp với GOOGLE_CALLBACK_URL
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_APP_DEEP_LINK=tropia://auth/callback

# ── Email (SMTP Gmail) ────────────────────────────────────────────────────────
# App Password: myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=your@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM_NAME=Tropia

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── MoMo ─────────────────────────────────────────────────────────────────────
# sandbox: https://test-payment.momo.vn  |  production: https://payment.momo.vn
MOMO_PARTNER_CODE=CHANGE_ME
MOMO_ACCESS_KEY=CHANGE_ME
MOMO_SECRET_KEY=CHANGE_ME
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo/result
MOMO_IPN_URL=http://localhost:3000/api/payment/momo/ipn
MOMO_API_URL=https://test-payment.momo.vn

# ── ZaloPay ───────────────────────────────────────────────────────────────────
# sandbox: sb-openapi.zalopay.vn  |  production: openapi.zalopay.vn
ZALOPAY_APP_ID=CHANGE_ME
ZALOPAY_KEY1=CHANGE_ME
ZALOPAY_KEY2=CHANGE_ME
ZALOPAY_CALLBACK_URL=http://localhost:3000/api/payment/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:3000/payment/zalopay/result
ZALOPAY_API_CREATE=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_API_QUERY=https://sb-openapi.zalopay.vn/v2/query

# ── VNPay ─────────────────────────────────────────────────────────────────────
# sandbox: sandbox.vnpayment.vn  |  production: pay.vnpay.vn
VNP_TMN_CODE=CHANGE_ME
VNP_HASH_SECRET=CHANGE_ME
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/payment/vnpay/return
