# Tropia Go Backend - Environment Template
# Copy to .env.development for local dev

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
GIN_MODE=debug
# Comma-separated whitelist of frontend origins. NEVER use `*` —
# AllowCredentials=true + `*` is rejected by modern browsers. Examples:
#   dev:   http://localhost:3000,http://10.0.2.2:3000
#   prod:  https://tropia.vn,https://app.tropia.vn
CORS_ORIGIN=http://localhost:3000

# ── Postgres ──────────────────────────────────────────────────────────────────
# Dev uses sslmode=disable against the local Docker Postgres. Production
# (GIN_MODE=release) MUST use sslmode=require or verify-full — the config
# loader refuses to boot otherwise. Supabase + most managed PG providers:
#   DATABASE_URL=postgres://user:pwd@db.x.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://tropia:tropia_dev_password@localhost:5433/tropia?sslmode=disable

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
# generate: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_BYTES_LONG
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_AT_LEAST_32_BYTES_LONG
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── SRS (media server) ────────────────────────────────────────────────────────
# Public-facing URLs (what clients connect to)
SRS_RTMP_HOST=rtmp://localhost:1935
SRS_HLS_HOST=http://localhost:8090
# ^ Points at the nginx reverse proxy (infra/nginx/hls-proxy.conf) NOT
# SRS's raw HLS port. The proxy adds HTTP keep-alive so a long-watching
# browser doesn't exhaust Windows' ephemeral TCP port pool (SRS itself
# sends `Connection: close` on every response).
SRS_WHIP_HOST=http://localhost:1985
# Internal SRS HTTP API (for backend → SRS calls)
SRS_API_HOST=http://localhost:1985
# Shared secret SRS appends to its webhook URLs as `?secret=…`. The
# backend rejects any webhook call without a matching value — without
# this, anyone reachable to the backend port could forge on_publish
# / on_dvr and mark fake streams live or trigger junk R2 uploads.
# Production MUST set this (the API refuses to boot in release mode
# without it). Must also be set in infra/srs/srs.conf http_hooks URLs.
SRS_WEBHOOK_SECRET=dev-secret

# Versioned HMAC keys used to sign publish/playback URLs. JSON map
# of {kid → secret}; multiple keys can be active so the operator
# rotates without downtime (issue new kid, wait until tokens signed
# under the old kid expire naturally, then drop it).
#
# Empty disables token signing (URLs are bare paths — dev only).
# In production, both Tropia and the infra-side SRS must hold the
# same map and route by kid.
#
# Generate a secret:  openssl rand -hex 32
SRS_TOKEN_KEYS_JSON=
#   example for staging:
#   SRS_TOKEN_KEYS_JSON={"v2026-01":"61c1a4...","v2026-02":"9b3f8d..."}

# Which kid signs NEW tokens. Must exist in SRS_TOKEN_KEYS_JSON.
# Old tokens signed under other kids continue to verify until their
# TTL expires — that's the whole point of versioning.
SRS_TOKEN_CURRENT_KID=

# Token lifetime. Shorter = more rotation but smaller replay window
# on leak. 15m is the industry default for signed media URLs.
SRS_TOKEN_TTL=15m

# ── Stream key provider ───────────────────────────────────────────────────────
# local: Tropia generates with crypto/rand (default — fine for dev / CI).
# infra: Tropia calls INFRA_STREAM_API_URL/api/v1/streams/issue to obtain
#        the key. Infra becomes the registry-of-record; they can audit
#        and revoke every key. Required in production. See
#        docs/SECURITY.md → "Stream key provider contract".
STREAM_KEY_PROVIDER=local
INFRA_STREAM_API_URL=
INFRA_STREAM_API_KEY=
# true  = if infra is unreachable, fall back to local generation.
# false = fail closed (production stance — unauthorised keys are worse
#         than a brief outage on the create endpoint).
STREAM_KEY_PROVIDER_ALLOW_FALLBACK=false

# ── Cloudflare R2 (VOD storage) ───────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=tropia-vod
R2_PUBLIC_URL=https://vod.tropia.vn

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# ── Payment: MoMo (sandbox: https://test-payment.momo.vn) ─────────────────────
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:3000/api/payment/momo/callback
MOMO_IPN_URL=http://localhost:3000/api/payment/momo/ipn

# ── Payment: VNPay (sandbox: https://sandbox.vnpayment.vn/...) ────────────────
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/payment/vnpay/return

# ── Payment: ZaloPay (sandbox keys are public — see ZaloPay docs) ─────────────
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_API_CREATE=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_API_QUERY=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_CALLBACK_URL=http://localhost:3000/api/payment/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:3000/payment-result

# ── DeepSeek AI ───────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ── SMTP email ────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Tropia

# ── Client URL (for payment redirect) ─────────────────────────────────────────
CLIENT_URL=http://localhost:8080
