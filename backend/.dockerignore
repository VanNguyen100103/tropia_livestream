# Tropia backend (Go) — Docker build context excludes
#
# The Dockerfile only needs go.mod, go.sum, cmd/, and internal/. Everything
# else just bloats the build context and risks leaking secrets.

# ── Real .env files — NEVER ship secrets in the image ────────────────────────
.env
.env.development
.env.staging
.env.production
.env.local
.env.test

# ── Local build artifacts (Go builds inside the container) ───────────────────
api
api.exe
bin/
dist/
tmp/

# ── Version control & IDE ────────────────────────────────────────────────────
.git/
.gitignore
.dockerignore
.idea/
.vscode/
*.iml
*.code-workspace

# ── Documentation (not needed at runtime) ────────────────────────────────────
README.md
AUDIT.md
*.md

# ── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Test files (production image doesn't run tests) ──────────────────────────
*_test.go
testdata/

# ── Go vendor (if you ever vendor — image uses go mod download instead) ─────
vendor/
