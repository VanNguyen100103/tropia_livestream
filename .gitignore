# =============================================================================
# Tropia monorepo .gitignore
# =============================================================================
# Top-level layout:
#   frontend/   Flutter app
#   backend/    Go API
#   infra/      Docker Compose (dev)
#   k8s/        Kubernetes manifests (prod)

# ── Miscellaneous ────────────────────────────────────────────────────────────
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ── IDE ──────────────────────────────────────────────────────────────────────
*.iml
*.ipr
*.iws
.idea/
# .vscode/   uncomment if you want to ignore VSCode workspace settings

# ── Flutter / Dart / Pub (frontend/) ─────────────────────────────────────────
frontend/.dart_tool/
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/coverage/
frontend/flutter_run.log

# Native build artifacts
frontend/**/doc/api/
frontend/**/ios/Flutter/.last_build_id
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/

# Symbolication / obfuscation
frontend/app.*.symbols
frontend/app.*.map.json

# ── Backend Go (backend/) ────────────────────────────────────────────────────
# Real .env files (only .env.example committed)
backend/.env
backend/.env.development
backend/.env.staging
backend/.env.production
backend/.env.local
backend/.env.test

# Go build artifacts
backend/tmp/
backend/dist/
backend/api
backend/api.exe

# ── Kubernetes secrets (k8s/) ────────────────────────────────────────────────
# Only secrets.example.yaml is committed
k8s/secrets.yaml

# ── Infra runtime data (infra/) ──────────────────────────────────────────────
# Docker volumes are NOT in this folder (Docker stores them separately),
# but if anyone bind-mounts data here, ignore it.
infra/data/
infra/dvr/
