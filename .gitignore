# =============================================================================
# Tropia monorepo .gitignore
# =============================================================================
# Top-level layout:
#   frontend/   Flutter app
#   backend/    Go API
#   infra/      Docker Compose (dev)
#   k8s/        Kubernetes manifests (prod)

# ── Miscellaneous ────────────────────────────────────────────────────────────
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ── IDE ──────────────────────────────────────────────────────────────────────
*.iml
*.ipr
*.iws
.idea/
# .vscode/   uncomment if you want to ignore VSCode workspace settings

# ── Claude Code local settings (personal, machine-specific) ──────────────────
.claude/

# ── Flutter / Dart / Pub (frontend/) ─────────────────────────────────────────
frontend/.dart_tool/
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/coverage/
frontend/flutter_run.log

# Native build artifacts
frontend/**/doc/api/
frontend/**/ios/Flutter/.last_build_id
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/

# Symbolication / obfuscation
frontend/app.*.symbols
frontend/app.*.map.json

# Real env files consumed by --dart-define-from-file (only env.example.json
# is committed; copy it to env.development.json / env.staging.json /
# env.production.json and fill in real values per environment).
frontend/env.development.json
frontend/env.staging.json
frontend/env.production.json
frontend/env.local.json

# ── Backend Go (backend/) ────────────────────────────────────────────────────
# Real .env files (only .env.example committed)
backend/.env
backend/.env.development
backend/.env.staging
backend/.env.production
backend/.env.local
backend/.env.test

# Go build artifacts
backend/tmp/
backend/dist/
backend/api
backend/api.exe

# ── Kubernetes secrets (k8s/) ────────────────────────────────────────────────
# Only secrets.example.yaml is committed
k8s/secrets.yaml

# ── Infra runtime data (infra/) ──────────────────────────────────────────────
# Docker volumes are NOT in this folder (Docker stores them separately),
# but if anyone bind-mounts data here, ignore it.
infra/data/
infra/dvr/
.commit_msg.tmp

# Stray screen-recording artifacts
backend/cmd/bake-test/Screen Recording*.mp4

# ── Old Flutter app (frontend/) — replaced by frontend_main/, kept local only ─
/frontend/

# ── Flutter / Dart / Pub (frontend_main/) ────────────────────────────────────
frontend_main/.dart_tool/
frontend_main/.flutter-plugins-dependencies
frontend_main/.pub-cache/
frontend_main/.pub/
frontend_main/build/
frontend_main/coverage/
frontend_main/flutter_run.log
frontend_main/**/doc/api/
frontend_main/**/ios/Flutter/.last_build_id
frontend_main/android/app/debug/
frontend_main/android/app/profile/
frontend_main/android/app/release/
frontend_main/app.*.symbols
frontend_main/app.*.map.json

# frontend_main secrets — NEVER commit
frontend_main/.env
frontend_main/.env.*
frontend_main/firebase-service-account.json
frontend_main/env.development.json
frontend_main/env.staging.json
frontend_main/env.production.json
frontend_main/env.local.json
layout2.png
